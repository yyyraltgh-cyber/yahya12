# ---------------------------------------------------------------------------
# Personal OS - Production environment template
# Fill these in via your hosting provider's secret manager (Vercel, etc.)
# or a CI/CD secrets store. Do not write real values into this file.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=https://your-production-domain.example.com
NEXT_PUBLIC_APP_ENV=production

# Set to "true" when building the static bundle that ships inside the
# Capacitor Android app (see scripts/build-android.sh).
CAPACITOR_BUILD=false
