# ---------------------------------------------------------------------------
# Personal OS - Local / Development environment template
# Copy this file to ".env.local" and fill in real values before running
# `npm run dev`. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anonymous/public API key (safe to expose to the client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key - server-side only, NEVER expose to the client
# or commit to version control. Used only inside server actions / route
# handlers under app/api/**.
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of the deployed web app (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# App environment: development | staging | production
NEXT_PUBLIC_APP_ENV=development
