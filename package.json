{
  "name": "personal-os",
  "version": "1.0.0",
  "private": true,
  "description": "Personal Operating System - a unified life management platform (tasks, notes, habits) built with Next.js 15 and Supabase.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "cap:sync": "next build && next export -o out || true && npx cap sync",
    "cap:android": "npx cap open android",
    "cap:build:android": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "next": "15.1.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "@supabase/supabase-js": "^2.45.4",
    "@supabase/ssr": "^0.5.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.7.5",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "postcss": "^8.4.47",
    "eslint": "^9.13.0",
    "eslint-config-next": "15.1.0",
    "@capacitor/core": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/android": "^6.1.2",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1",
    "@capacitor/app": "^6.0.1",
    "@eslint/eslintrc": "^3.1.0"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
